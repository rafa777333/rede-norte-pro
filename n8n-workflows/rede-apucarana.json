    {
      "parameters": {
        "jsCode": "const geminiRes = $input.item.json;\nconst cleanData = $('Code - Limpar Dados').item.json;\n\nlet headline = \"\";\ntry {\n  const candidate = geminiRes.candidates?.[0]?.content?.parts?.[0]?.text;\n  if (candidate) {\n    headline = candidate.replace(/[\"']/g, \"\").replace(/\\s+/g, \" \").trim();\n  }\n} catch (e) {}\n\nif (!headline || headline.length < 5) {\n  headline = cleanData.original_title;\n}\n\nreturn {\n  ...cleanData,\n  headline: headline\n};"
      },
