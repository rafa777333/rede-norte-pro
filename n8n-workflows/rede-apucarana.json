    {
      "parameters": {
        "jsCode": "const item = $input.item.json.body || $input.item.json;\n\n// 1. Limpa e normaliza o título original\nconst rawTitle = item.title || item.titulo || \"\";\nconst cleanTitle = rawTitle.replace(/<[^>]*>?/gm, \"\").replace(/\\s+/g, \" \").trim();\n\n// 2. Normaliza a categoria (sempre maiúscula)\nlet category = (item.categoria || item.category || \"NOTÍCIA\").replace(/<[^>]*>?/gm, \"\").trim().toUpperCase();\nif (category === \"GERAL\") category = \"NOTÍCIA\";\n\n// 3. Imagem original da matéria\nconst imageUrl = (item.image_url || item.imageUrl || item.imagem || \"\").trim();\n\n// 4. Link da matéria\nconst slug = item.slug || \"\";\nconst link = item.link || (slug ? `https://www.redeapucarana.com.br/noticias/${slug}` : \"https://www.redeapucarana.com.br\");\n\n// 5. Redes selecionadas\nconst networks = Array.isArray(item.networks) && item.networks.length > 0 ? item.networks : [\"facebook\", \"instagram\"];\nconst publicationId = item.publication_id || item.id || `pub_${Date.now()}`;\nconst newsId = item.news_id || \"\";\n\nreturn {\n  publication_id: publicationId,\n  news_id: newsId,\n  original_title: cleanTitle,\n  category: category,\n  image_url: imageUrl,\n  link: link,\n  networks: networks,\n  created_at: new Date().toISOString()\n};"
      },
      "id": "22222222-0001-4000-8000-000000000002",
      "name": "Code - Limpar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=INSERIR_GEMINI_API_KEY",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Você é um experiente editor jornalístico de rede social especialista em manchetes de alto impacto e clique para Instagram e Facebook.\\nReescreva o título jornalístico abaixo criando uma manchete magnética, urgente, direta e de fácil leitura, com no máximo 8 a 12 palavras (máximo 3 linhas visuais).\\nNÃO use aspas, NÃO use ponto final, NÃO use emojis e retorne APENAS a manchete final.\\n\\nTítulo original: \" + $('Code - Limpar Dados').item.json.original_title\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.4,\n    \"maxOutputTokens\": 60\n  }\n}",
        "options": {}
      },
      "id": "22222222-0001-4000-8000-000000000003",
      "name": "Gemini - Manchete de Impacto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const geminiRes = $input.item.json;\nconst cleanData = $('Code - Limpar Dados').item.json;\n\n// Extrai o texto gerado pelo Gemini com fallback seguro para o título original\nlet headline = \"\";\ntry {\n  const candidate = geminiRes.candidates?.[0]?.content?.parts?.[0]?.text;\n  if (candidate) {\n    headline = candidate.replace(/[\"'\r\n]/g, \" \").replace(/\\s+/g, \" \").trim();\n  }\n} catch (e) {}\n\nif (!headline || headline.length < 5) {\n  headline = cleanData.original_title;\n}\n\nreturn {\n  ...cleanData,\n  headline: headline\n};"
      },
