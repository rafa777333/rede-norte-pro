    {
      "parameters": {
        "jsCode": "const item = $input.item.json.body || $input.item.json;\n\nfunction decodeHtml(str) {\n  if (!str) return \"\";\n  return String(str)\n    .replace(/&#(\\d+);/g, (_, dec) => String.fromCharCode(dec))\n    .replace(/&#x([0-9a-fA-F]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))\n    .replace(/&quot;/gi, '\"')\n    .replace(/&apos;/gi, \"'\")\n    .replace(/&amp;/gi, \"&\")\n    .replace(/&lt;/gi, \"<\")\n    .replace(/&gt;/gi, \">\")\n    .replace(/&nbsp;/gi, \" \")\n    .replace(/&ndash;/gi, \"–\")\n    .replace(/&mdash;/gi, \"—\");\n}\n\nfunction generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\n// 1. Limpa e normaliza o título original (decodificando entidades como &#039;)\nconst rawTitle = item.title || item.titulo || \"\";\nconst cleanTitle = decodeHtml(rawTitle).replace(/<[^>]*>?/gm, \"\").replace(/\\s+/g, \" \").trim();\n\n// 2. Normaliza a categoria (sempre maiúscula)\nlet category = decodeHtml(item.categoria || item.category || \"NOTÍCIA\").replace(/<[^>]*>?/gm, \"\").trim().toUpperCase();\nif (category === \"GERAL\") category = \"NOTÍCIA\";\n\n// 3. Imagem original da matéria\nconst imageUrl = (item.image_url || item.imageUrl || item.imagem || \"\").trim();\n\n// 4. Link da matéria\nconst slug = item.slug || \"\";\nconst link = item.link || (slug ? `https://www.redeapucarana.com.br/noticias/${slug}` : \"https://www.redeapucarana.com.br\");\n\n// 5. Redes selecionadas\nconst networks = Array.isArray(item.networks) && item.networks.length > 0 ? item.networks : [\"facebook\", \"instagram\"];\n\n// 6. UUID garantido para evitar erro 22P02 no Supabase\nconst rawPubId = String(item.publication_id || item.id || \"\").trim();\nconst isUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(rawPubId);\nconst publicationId = isUuid ? rawPubId : generateUUID();\nconst newsId = item.news_id || \"\";\n\nreturn {\n  publication_id: publicationId,\n  news_id: newsId,\n  original_title: cleanTitle,\n  category: category,\n  image_url: imageUrl,\n  link: link,\n  networks: networks,\n  created_at: new Date().toISOString()\n};"
      },
